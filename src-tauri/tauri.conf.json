{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TALOS",
  "version": "0.1.0",
  "identifier": "com.pakiknowledge.talos.desktop",
  "build": {
    "beforeDevCommand": "node tools/build-desktop.mjs",
    "beforeBuildCommand": "node tools/build-desktop.mjs",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; font-src 'self' http://127.0.0.1:*",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../dist-desktop/talos-desktop-service.mjs": "desktop/talos-desktop-service.mjs",
      "../dist-desktop/static/": "desktop/static/"
    }
  }
}
